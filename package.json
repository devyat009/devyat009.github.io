{
  "name": "my-page",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "clean:themes": "del-cli src/assets/themes/*.css",
    "prebuild:themes": "npm run clean:themes",
    "build:themes": "sass --no-source-map src/theme-light.scss src/assets/themes/theme-light.css && sass --no-source-map src/theme-dark.scss src/assets/themes/theme-dark.css",
    "prewatch:themes:sass": "npm run clean:themes",
    "watch:themes": "concurrently \"npm run watch:themes:sass\" \"npm run start:ng\"",
    "watch:themes:sass": "sass --watch src/theme-light.scss:src/assets/themes/theme-light.css src/theme-dark.scss:src/assets/themes/theme-dark.css --no-source-map",
    "start": "npm run build:themes && ng serve",
    "start:ng": "ng serve",
    "start:dev": "concurrently \"npm run watch:themes:sass\" \"npm run start:ng\"",
    "build": "npm run build:themes && ng build",
    "watch": "npm run build:themes && ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:app-crud": "node dist/app-crud/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/ssr": "^22.2.6",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@tailwindcss/postcss": "^4.1.6",
    "app-crud": "file:",
    "express": "^4.18.2",
    "material-symbols": "^0.31.2",
    "my-page": "file:",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "del-cli": "^6.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-force-resolutions": "^0.0.10",
    "postcss": "^8.5.3",
    "sass": "^1.87.0",
    "tailwindcss": "^4.1.6",
    "typescript": "~6.0.3"
  }
}